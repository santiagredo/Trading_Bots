{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "tb-dt-application",
    "version": "0.1.0",
    "identifier": "com.tb.dt.application",
    "build": {
        "beforeDevCommand": "bash src-tauri/scripts/prepare-engine-dev.sh",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bash src-tauri/scripts/prepare-engine-build.sh",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "tb-dt-application",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": ["bin/application"]
    }
}
